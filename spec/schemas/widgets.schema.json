{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["widgets", "exclusions"],
  "properties": {
    "widgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "package", "purpose", "category", "example", "source", "docs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["input", "display", "layout", "infra"]},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "example": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "docs": {"type": "string", "minLength": 1},
          "ticket": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
