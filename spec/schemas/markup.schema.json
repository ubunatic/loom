{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom .tui bracket markup specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors"],
  "properties": {
    "colors": {
      "type": "object",
      "description": "Named colors mapped to 256-color palette indexes",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 255 }
    }
  }
}
