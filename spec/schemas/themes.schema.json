{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom widget color themes specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes"],
  "properties": {
    "themes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/theme"
      },
      "minProperties": 1
    }
  },
  "definitions": {
    "themeColor": {
      "description": "terminal default, a 256-color palette index, or a six-digit RGB value",
      "oneOf": [
        { "const": "default" },
        { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal_fg",   "normal_bg",
        "selected_fg", "selected_bg", "selected_bold",
        "header_fg",   "header_bg",   "header_bold",
        "prompt_fg",   "prompt_bg",
        "placeholder_fg", "placeholder_bg", "placeholder_dim",
        "scrollbar_track_fg", "scrollbar_track_bg", "scrollbar_track_dim",
        "scrollbar_thumb_fg", "scrollbar_thumb_bg", "scrollbar_thumb_bold",
        "status_fg", "status_bg", "status_bold", "status_dim",
        "progress_fg", "progress_bg", "progress_bold",
        "border_fg",   "border_bg",
        "focus_bg", "media_loading_fg", "media_loading_dim", "media_error_fg"
      ],
      "properties": {
        "normal_fg":     { "$ref": "#/definitions/themeColor" },
        "normal_bg":     { "$ref": "#/definitions/themeColor" },
        "selected_fg":   { "$ref": "#/definitions/themeColor" },
        "selected_bg":   { "$ref": "#/definitions/themeColor" },
        "selected_bold": { "type": "boolean" },
        "header_fg":     { "$ref": "#/definitions/themeColor" },
        "header_bg":     { "$ref": "#/definitions/themeColor" },
        "header_bold":   { "type": "boolean" },
        "prompt_fg":     { "$ref": "#/definitions/themeColor" },
        "prompt_bg":     { "$ref": "#/definitions/themeColor" },
        "placeholder_fg":  { "$ref": "#/definitions/themeColor" },
        "placeholder_bg":  { "$ref": "#/definitions/themeColor" },
        "placeholder_dim": { "type": "boolean" },
        "scrollbar_track_fg": { "$ref": "#/definitions/themeColor" },
        "scrollbar_track_bg": { "$ref": "#/definitions/themeColor" },
        "scrollbar_track_dim": { "type": "boolean" },
        "scrollbar_thumb_fg": { "$ref": "#/definitions/themeColor" },
        "scrollbar_thumb_bg": { "$ref": "#/definitions/themeColor" },
        "scrollbar_thumb_bold": { "type": "boolean" },
        "status_fg": { "$ref": "#/definitions/themeColor" },
        "status_bg": { "$ref": "#/definitions/themeColor" },
        "status_bold": { "type": "boolean" },
        "status_dim": { "type": "boolean" },
        "progress_fg": { "$ref": "#/definitions/themeColor" },
        "progress_bg": { "$ref": "#/definitions/themeColor" },
        "progress_bold": { "type": "boolean" },
        "border_fg":     { "$ref": "#/definitions/themeColor" },
        "border_bg":     { "$ref": "#/definitions/themeColor" },
        "focus_bg":      { "$ref": "#/definitions/themeColor" },
        "media_loading_fg": { "$ref": "#/definitions/themeColor" },
        "media_loading_dim": { "type": "boolean" },
        "media_error_fg": { "$ref": "#/definitions/themeColor" },
        "key_cap_fg": { "$ref": "#/definitions/themeColor" },
        "key_cap_bg": { "$ref": "#/definitions/themeColor" },
        "modified_fg": { "$ref": "#/definitions/themeColor" },
        "saved_fg": { "$ref": "#/definitions/themeColor" }
      }
    }
  }
}
