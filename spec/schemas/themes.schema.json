{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom widget color themes specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes"],
  "properties": {
    "themes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/theme"
      },
      "minProperties": 1
    }
  },
  "definitions": {
    "colorIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "256-color palette index; 0 means terminal default (reset)"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal_fg",   "normal_bg",
        "selected_fg", "selected_bg", "selected_bold",
        "header_fg",   "header_bg",   "header_bold",
        "prompt_fg",   "prompt_bg",
        "border_fg",   "border_bg",
        "focus_bg"
      ],
      "properties": {
        "normal_fg":     { "$ref": "#/definitions/colorIndex" },
        "normal_bg":     { "$ref": "#/definitions/colorIndex" },
        "selected_fg":   { "$ref": "#/definitions/colorIndex" },
        "selected_bg":   { "$ref": "#/definitions/colorIndex" },
        "selected_bold": { "type": "boolean" },
        "header_fg":     { "$ref": "#/definitions/colorIndex" },
        "header_bg":     { "$ref": "#/definitions/colorIndex" },
        "header_bold":   { "type": "boolean" },
        "prompt_fg":     { "$ref": "#/definitions/colorIndex" },
        "prompt_bg":     { "$ref": "#/definitions/colorIndex" },
        "border_fg":     { "$ref": "#/definitions/colorIndex" },
        "border_bg":     { "$ref": "#/definitions/colorIndex" },
        "focus_bg":      { "$ref": "#/definitions/colorIndex" }
      }
    }
  }
}
