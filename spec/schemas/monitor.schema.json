{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom static monitor document (shell vocabulary)",
  "type": "object",
  "additionalProperties": false,
  "required": ["app"],
  "oneOf": [{"required": ["pane"]}, {"required": ["view"]}, {"required": ["views"]}],
  "properties": {
    "app": {
      "type": "object", "additionalProperties": false,
      "required": ["height", "max_width"],
      "properties": {
        "height": {"type": "integer", "minimum": 1},
        "max_width": {"type": "integer", "minimum": 1},
        "root": {"type": "string", "minLength": 1}
      }
    },
    "pane": {"$ref": "#/definitions/view"},
    "view": {"$ref": "#/definitions/view"},
    "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/view"}}
  },
  "definitions": {
    "text": {"type": "string", "pattern": "^[ -~]*$"},
    "view": {
      "type": "object", "additionalProperties": false, "required": ["frame"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "frame": {
          "type": "object", "additionalProperties": false, "required": ["boxes"],
          "properties": {
            "title": {"$ref": "#/definitions/text"},
            "status": {"$ref": "#/definitions/text"},
            "gap": {"type": "integer", "minimum": 0},
            "breakpoint": {"type": "integer", "minimum": 0},
            "control_separator": {"$ref": "#/definitions/text"},
            "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}},
            "boxes": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/box"}}
          }
        }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "key"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"enum": ["toggle", "quit"]},
        "key": {"type": "string", "pattern": "^([!-~]|ctrl-c)$"},
        "target": {"type": "string"},
        "hint": {"$ref": "#/definitions/text"},
        "hidden_hint": {"$ref": "#/definitions/text"},
        "title_hint": {"$ref": "#/definitions/text"}
      }
    },
    "rows": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "values", "gap", "ellipsis"],
      "properties": {
        "gap": {"type": "integer", "minimum": 0},
        "ellipsis": {"type": "string"},
        "columns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["width"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "align": {"enum": ["left", "right"]},
              "bold": {"type": "boolean"}
            }
          }
        },
        "values": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "box": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "width", "height"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[ -~]+$"},
        "title": {"$ref": "#/definitions/text"},
        "width": {"type": "integer", "minimum": 2},
        "height": {"type": "integer", "minimum": 2},
        "padding": {"type": "integer", "minimum": 0}
        ,"rows": {"$ref": "#/definitions/rows"}
        ,"hidden": {"type": "boolean"}
      }
    }
  }
}
