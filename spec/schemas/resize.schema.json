{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom Winch resize modes specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["modes"],
  "properties": {
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coalesce",
        "atomic_flush",
        "row_clear",
        "synchronized_output",
        "auto_wrap",
        "out_of_band_clear",
        "full_screen_buffer",
        "resize_handling",
        "width_guard",
        "adaptive_guard",
        "alt_screen"
      ],
      "properties": {
        "coalesce": { "$ref": "#/definitions/mode" },
        "atomic_flush": { "$ref": "#/definitions/mode" },
        "row_clear": { "$ref": "#/definitions/mode" },
        "synchronized_output": { "$ref": "#/definitions/mode" },
        "auto_wrap": { "$ref": "#/definitions/mode" },
        "out_of_band_clear": { "$ref": "#/definitions/mode" },
        "full_screen_buffer": { "$ref": "#/definitions/mode" },
        "resize_handling": { "$ref": "#/definitions/mode" },
        "width_guard": { "$ref": "#/definitions/mode" },
        "adaptive_guard": { "$ref": "#/definitions/mode" },
        "alt_screen": { "$ref": "#/definitions/mode" }
      }
    }
  },
  "definitions": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "default", "diagnostic_only", "key"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "default": { "type": "boolean" },
        "diagnostic_only": { "type": "boolean" },
        "key": { "type": "string", "minLength": 1 },
        "guard_n": { "type": "integer", "minimum": 1 },
        "window_ms": { "type": "integer", "minimum": 1 },
        "min_n": { "type": "integer", "minimum": 1 },
        "max_n": { "type": "integer", "minimum": 1 },
        "rate_step": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
