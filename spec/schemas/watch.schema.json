{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["collect", "redraw", "clock_format", "title", "status", "command", "description", "watch_help", "width_help"],
  "properties": {
    "collect": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"},
    "redraw": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$"},
    "clock_format": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "command": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "watch_help": {"type": "string", "minLength": 1}
    ,"width_help": {"type": "string", "minLength": 1}
  }
}
