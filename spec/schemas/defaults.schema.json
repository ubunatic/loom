{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loom runtime defaults specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["fallback_quit_keys", "pane", "scrollbar", "mouse", "splash", "spinner", "progress_bar", "media", "clock", "paint_canvas", "search_bar", "rich_text_edit"],
  "properties": {
    "search_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "placeholder"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string", "minLength": 1 }
      }
    },
    "rich_text_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_bg", "toolbar_fg", "toolbar_bg", "separator_glyph", "separator_fg", "separator_bg", "pointer_up_glyph", "pointer_down_glyph", "pointer_fg", "popover_labels", "box_style_labels", "box_style_default", "ghost_cursor_enabled", "popover_focus_fg", "popover_focus_bg", "link_fg", "link_underline", "save_popup_max_width", "save_popup_max_height"],
      "properties": {
        "selection_bg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "toolbar_fg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "toolbar_bg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "separator_glyph": { "type": "string", "minLength": 1 },
        "separator_fg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "separator_bg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "pointer_up_glyph": { "type": "string", "minLength": 1 },
        "pointer_down_glyph": { "type": "string", "minLength": 1 },
        "pointer_fg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "popover_labels": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string", "minLength": 1 } },
        "box_style_labels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "box_style_default": { "type": "string", "enum": ["plain", "rounded"] },
        "ghost_cursor_enabled": { "type": "boolean" },
        "popover_focus_fg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "popover_focus_bg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "link_fg": { "type": "integer", "minimum": 0, "maximum": 255 },
        "link_underline": { "type": "boolean" },
        "save_popup_max_width": { "type": "integer", "minimum": 8 },
        "save_popup_max_height": { "type": "integer", "minimum": 7 }
      }
    },
    "paint_canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tune_label", "smoothing_label", "smoothing_levels"],
      "properties": {
        "tune_label": { "type": "string", "minLength": 1 },
        "smoothing_label": { "type": "string", "minLength": 1 },
        "smoothing_levels": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "reset"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "stop": { "type": "string", "minLength": 1 },
        "reset": { "type": "string", "minLength": 1 }
      }
    },
    "fallback_quit_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["esc", "ctrl-c", "ctrl-q", "ctrl-d", "q"]
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cols", "esc_key_timeout", "guard_duration", "view_pan_step"],
      "properties": {
        "max_cols": { "type": "integer", "minimum": 1 },
        "esc_key_timeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "guard_duration": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "view_pan_step": { "type": "integer", "minimum": 1 }
      }
    },
    "scrollbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "foreground_char", "background_char"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "always", "never"] },
        "foreground_char": { "type": "string", "minLength": 1 },
        "background_char": { "type": "string", "minLength": 1 }
      }
    },
    "mouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["double_click_interval", "movement_tolerance"],
      "properties": {
        "double_click_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "movement_tolerance": { "type": "integer", "minimum": 0 }
      }
    },
    "splash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bracket_width", "pill_gap", "footer_text", "step_text", "tick_interval", "hold_duration"],
      "properties": {
        "bracket_width": { "type": "integer", "minimum": 1 },
        "pill_gap": { "type": "integer", "minimum": 0 },
        "footer_text": { "type": "string" },
        "step_text": { "type": "string" },
        "tick_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "hold_duration": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    },
    "progress_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "done_pattern", "demo_interval", "demo_step"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "done_pattern": { "type": "string", "minLength": 1 },
        "demo_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "demo_step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "spinner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick_interval"],
      "properties": {
        "tick_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading_label", "render_error_label", "loading_threshold"],
      "properties": {
        "loading_label": { "type": "string", "minLength": 1 },
        "render_error_label": { "type": "string", "minLength": 1 },
        "loading_threshold": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    }
  }
}
