        "hotkey_open_binding": { "type": "string", "minLength": 1 },
        "hotkey_open_label": { "type": "string", "minLength": 1 },
        "hotkey_close_binding": { "type": "string", "minLength": 1 },
        "hotkey_close_label": { "type": "string", "minLength": 1 },
        "hotkey_view_edit_binding": { "type": "string", "minLength": 1 },
        "hotkey_quit_binding": { "type": "string", "minLength": 1 },
        "hotkey_quit_label": { "type": "string", "minLength": 1 },
        "help_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "entries"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "keys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "cap": { "type": "string" },
                    "ref": { "type": "string" },
                    "label": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "paint_canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tune_label", "smoothing_label", "smoothing_levels"],
      "properties": {
        "tune_label": { "type": "string", "minLength": 1 },
        "smoothing_label": { "type": "string", "minLength": 1 },
        "smoothing_levels": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop", "reset"],
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "stop": { "type": "string", "minLength": 1 },
        "reset": { "type": "string", "minLength": 1 }
      }
    },
    "quit_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["ctrl-q", "f10"]
      }
    },
    "escape_quits": { "type": "boolean" },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cols", "esc_key_timeout", "guard_duration", "view_pan_step"],
      "properties": {
        "max_cols": { "type": "integer", "minimum": 1 },
        "esc_key_timeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "guard_duration": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "view_pan_step": { "type": "integer", "minimum": 1 },
        "kitty_keyboard": { "type": "boolean" }
      }
    },
    "scrollbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "foreground_char", "background_char"],
      "properties": {
        "mode": { "type": "string", "enum": ["auto", "always", "never"] },
        "foreground_char": { "type": "string", "minLength": 1 },
        "background_char": { "type": "string", "minLength": 1 }
      }
    },
    "mouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["double_click_interval", "movement_tolerance"],
      "properties": {
        "double_click_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "movement_tolerance": { "type": "integer", "minimum": 0 }
      }
    },
    "splash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bracket_width", "pill_gap", "footer_text", "step_text", "tick_interval", "hold_duration"],
      "properties": {
        "bracket_width": { "type": "integer", "minimum": 1 },
        "pill_gap": { "type": "integer", "minimum": 0 },
        "footer_text": { "type": "string" },
        "step_text": { "type": "string" },
        "tick_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "hold_duration": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    },
    "progress_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "done_pattern", "demo_interval", "demo_step"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "done_pattern": { "type": "string", "minLength": 1 },
        "demo_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
        "demo_step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "spinner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick_interval"],
      "properties": {
        "tick_interval": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_background_ansi", "bar", "sparkline", "stacked_bar", "treemap", "spinner"],
      "properties": {
        "default_background_ansi": { "type": "string", "pattern": "^[0-9]+(;[0-9]+)*$" },
        "bar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_width"],
          "properties": { "max_width": { "type": "integer", "minimum": 1 } }
        },
        "sparkline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glyphs"],
          "properties": { "glyphs": { "type": "string", "minLength": 2 } }
        },
        "stacked_bar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glyphs"],
          "properties": { "glyphs": { "type": "string", "minLength": 1 } }
        },
        "treemap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glyphs"],
          "properties": { "glyphs": { "type": "string", "minLength": 1 } }
        },
        "spinner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frames", "harnez_frames"],
          "properties": {
            "frames": { "type": "string", "minLength": 1 },
            "harnez_frames": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading_label", "render_error_label", "loading_threshold"],
      "properties": {
        "loading_label": { "type": "string", "minLength": 1 },
        "render_error_label": { "type": "string", "minLength": 1 },
        "loading_threshold": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
      }
    }
  }
}
